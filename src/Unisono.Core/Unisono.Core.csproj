<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not UI: Drive and Synology backends, the sync engine and the sync host.
       Shared by the tray app (Unisono.exe) and the command line (UnisonoCli.exe). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Unisono</RootNamespace>
    <AssemblyName>Unisono.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.76.0.4261" />
    <!-- DPAPI for the NAS password (per Windows user; no admin, no key management). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
